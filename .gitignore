# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
ENV/

# Environment files
.env
.env.local
.env.*.local
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing
.coverage
htmlcov/
.pytest_cache/

# Distribution
dist/
build/
*.egg-info/
*.egg

# OS
*.log

# Image data and trained weights stay out of git, but the fixed split does not:
# it is what makes reported numbers reproducible across machines and runs.
datasets/*
!datasets/split.json
weights/

# Where Ultralytics writes evaluation output: a folder of plots per run,
# named val, val2, val3 and so on. A hundred and forty-four of them went
# into a commit once because they are created by tools that are run before
# committing, not after.
runs/
*.pt
.venv-tools/

# Id of a rented GPU, local to whoever rented it.
.vast-instance
.vast-offers.json
.vast-serve-instance
