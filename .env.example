# FixHome AI Service Environment Configuration
# Copy this file to .env and fill in the values

# Engine: "local" runs the self-hosted pipeline, "mock" is for tests and CI
AI_ENGINE=local

# Detector stage (YOLOv8n). Leave blank to run the deterministic stub.
YOLO_WEIGHTS_PATH=
DETECTOR_CONFIDENCE_THRESHOLD=0.45

# Vision-language stage (Qwen2.5-VL served by vLLM). Leave blank for the stub.
VLM_BASE_URL=
VLM_MODEL_NAME=Qwen/Qwen2.5-VL-3B-Instruct-AWQ
VLM_TIMEOUT_SECONDS=8.0
# Only if the vLLM endpoint was started with --api-key.
VLM_API_KEY=
# The served fault adapter's name (docker/lora), empty for the base model. The
# serving image sets it itself when started with LORA_RUN.
VLM_FAULT_MODEL=
VLM_FAULT_CANDIDATES=10

# Retrieval
RETRIEVAL_TOP_K=5
# Evidence beside the curated symptom lists: the customer-language sections of
# each fault file, and app/data/learned_phrasings.json. 0 turns one off.
RETRIEVAL_WRITTEN_WEIGHT=1.5
RETRIEVAL_LEARNED_WEIGHT=1.5

# Backend's public service catalogue, followed while running so new services,
# names and prices need no retraining and no redeploy. Blank: static mapping only.
# Example: https://<backend>/api/v1/services
BACKEND_CATALOG_URL=
CATALOG_REFRESH_SECONDS=300

# Advisory behavior
AI_CONFIDENCE_THRESHOLD=0.6

# Image intake guardrails
IMAGE_MAX_BYTES=8388608

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000"]

# Tooling only, never needed to run the service. Put real values in .env,
# which is git-ignored. Do not commit them and do not paste them into chat.
# ROBOFLOW_API_KEY: the Private API Key from Roboflow Settings > API Keys.
# The Publishable Key is for browser inference widgets and cannot download.
ROBOFLOW_API_KEY=
# Optional paid image search for tools/collect_images.py fetch.
SERPER_API_KEY=
# Hugging Face token with the Write role, for tools/hub.py and the trainer.
# A Read token downloads but cannot upload, and the error does not say so.
HF_TOKEN=
# Which Hub repositories the trainer pulls from and pushes to.
HF_DATASET_REPO=
HF_WEIGHTS_REPO=

# Docker Hub, only for publishing the trainer image. Needed because this
# organisation forbids public GHCR packages and only an organisation owner
# can lift that, which would leave a rented machine having to log in to pull.
# Use an access token, not the account password.
# Copy these into GitHub with: python tools/ci_secrets.py push
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
